# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# Decompressed / Raw Heavy Data
# (Keep the original .pgm.gz, ignore runtime decompressed .pgm files)
*.pgm
!data/raw/radar/pysteps_data/*.pgm.gz

# Runtime SQLite Database & WAL logs
data/processed/*.db
data/processed/*.db-journal
data/processed/*.db-wal
data/processed/*.db-shm
*.db
*.sqlite3

# Daemon Runtime / Generated Flat Files
radar_obs.npy
radar_forecast.npy
live_hazard_alerts.json
forecast_storm_cells.json
replay_state.json
dispatched_alerts_log.json
verification_metrics.json

# RainViewer multi-zone pipeline runtime outputs
*.npy
*_status.json
*_hazard_alerts.json
*_forecast_cells.json
tests/*_cache/

# PyTorch Model Checkpoints & Large Weights
*.pth
*.pt
*.onnx

# Backups (from debugging/patching sessions)
*.backup*
*.backup

# Node (if accidentally installed, e.g. for Playwright testing)
node_modules/
package.json
package-lock.json

# Temporary repair & one-off utility scripts
fix_encoding.py
replace_mojibake.py
replace_remaining.py

# Jupyter Notebook & Profiling checkpoints
.ipynb_checkpoints/

